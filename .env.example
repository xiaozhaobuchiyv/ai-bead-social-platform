# ============ Docker Compose 生产环境变量（复制为 .env 后修改） ============
# 说明：docker compose 会在项目根目录读取 .env 做变量替换。复制本文件为 .env 并修改。
#       后端容器用这里的 DB/JWT/CORS 变量；前端镜像用 PUBLIC_BASE_URL 作为 VITE_API_BASE。

# 数据库 root 密码（务必改成强密码）
DB_PASSWORD=change-me-strong-password

# JWT 密钥（务必改成 32 位以上随机字符串）
JWT_SECRET=change-me-random-64-char-at-least

# 对外访问地址（前端 Nginx 入口）
#   无域名时：http://<服务器公网IP>:8080
#   有域名后：https://your-domain.com
PUBLIC_BASE_URL=http://localhost:8080

# CORS 白名单：无域名可留 *；有域名后改为前端地址，如 https://your-domain.com
CORS_ORIGIN=*

# ============ 火山方舟 AI（暂不启用则留空，不影响其他功能） ============
VOLCANO_ARC_API_KEY=
VOLCANO_ARC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_CHAT_MODEL=
VOLCANO_IMAGE_MODEL=
VOLCANO_VISION_MODEL=
