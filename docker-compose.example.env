# ============================================================
# docker compose 运行所需环境变量模板
# 用法：cp docker-compose.example.env .env  然后修改（.env 不入库）
# 读取时机：后端每次启动时读取；修改后请 docker compose restart pindou-server
# ============================================================

# MySQL root 密码（请改成强密码；镜像与后端都用它）
DB_PASSWORD=change-me-db-password

# JWT 签名密钥（任意随机长串，勿外泄）
JWT_SECRET=change-me-jwt-secret

# 找回密码用的站内私人口令（仅站长知晓；忘记密码页需输入它）
# 未配置则“忘记密码”不可用
PASSWORD_RESET_CODE=change-me-reset-code

# 对外访问地址（无域名先填 http://公网IP:8080，有域名后改）
PUBLIC_BASE_URL=http://your-public-ip:8080

# 允许跨域来源（与 PUBLIC_BASE_URL 保持一致，一般同源网关可不改 *)
CORS_ORIGIN=http://your-public-ip:8080

# ============================================================
# 拼小豆 AI（公开部署请全部留空 = 整站关闭 AI，零调用成本）
# 想给自己留后门：填 Key/模型 并把 AI_ALLOWED_USERS 设为你的手机号(或用户ID)，
# 然后重启后端生效；白名单外用户/游客会看到“内部功能”且接口 403。
# ============================================================
VOLCANO_ARC_API_KEY=
VOLCANO_CHAT_MODEL=
VOLCANO_IMAGE_MODEL=
VOLCANO_VISION_MODEL=
AI_ALLOWED_USERS=
