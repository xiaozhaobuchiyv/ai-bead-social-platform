# ============ 基础 ============
# 复制为 .env 后修改
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# 生产环境对外访问地址（生成图片完整 URL 用）
# PUBLIC_BASE_URL=https://api.example.com

# ============ JWT ============
JWT_SECRET=your-random-secret-here
JWT_EXPIRES_IN=7d

# ============ MySQL ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=pindou
DB_POOL_SIZE=10
# 托管 MySQL（Aiven 等）通常端口非 3306 且强制 TLS：
#   DB_SSL=require         开启 TLS（跳过证书校验）
#   DB_SSL=require + DB_SSL_CA=/path/ca.pem   校验证书（Aiven 控制台可下载）
# DB_SSL= / disable        关闭（本地默认）
DB_SSL=
DB_SSL_CA=

# ============ 缓存（memory / redis） ============
# 驱动：redis 或 memory。未配置 Redis 时默认 memory（零依赖可运行）
CACHE_DRIVER=memory
CACHE_TTL_SECONDS=60
CACHE_MAX_ITEMS=500
CACHE_PREFIX=pindou:

# 生产建议用 Redis（跨进程/跨实例共享）。docker-compose 已内置 Redis 服务，设 CACHE_DRIVER=redis 即可。
# 托管 Redis（Upstash 等）：
#   1) 控制台复制 redis:// 或 rediss:// 连接串填到 REDIS_URL（rediss:// 自动走 TLS）
#   2) 托管服务通常只允许 0 号库：REDIS_DB=0
#   3) 用 URL 时无需再配 REDIS_HOST/PORT/PASSWORD；若以 host/port 直连且需 TLS 则设 REDIS_TLS=1
# 两种受支持的写法（二选一）：
#   REDIS_URL=redis://:password@127.0.0.1:6379/1
#   REDIS_URL=rediss://default:token@xxxx.upstash.io:6379
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TLS=0

# ============ 上传限制 ============
MAX_UPLOAD_SIZE_MB=10

# ============ CORS ============
# 生产建议指定前端域名，如 https://www.example.com
CORS_ORIGIN=*

# ============ 火山方舟 AI 配置 ============
# 注意：未配置这些变量（如公开部署不想开放拼小豆、避免调用费用）时，
# 前端进入拼小豆页会显示“正在建设中”占位，不会触发任何 AI 请求（GET /api/ai/status 探测）。
# 配置后即自动开放；如需仅给自己/白名单账号使用，可再叠加登录白名单控制。
VOLCANO_ARC_API_KEY=your-api-key-here
VOLCANO_ARC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 聊天模型（普通对话）
VOLCANO_CHAT_MODEL=your-chat-model-id

# 图片生成模型（文生图 / 图生图）
VOLCANO_IMAGE_MODEL=your-image-model-id

# 视觉模型（图片分析）
VOLCANO_VISION_MODEL=your-vision-model-id

# 拼小豆访问白名单（可选，强烈建议公开部署时配置）
# 逗号分隔的用户名或用户ID；为空 = 配了 key 即全员可用。
# 非空 = 仅白名单账号可用；游客/他人进入拼小豆会看到“内部功能/建设中”占位，
# 即使 key 已配置也不会产生任何模型调用。
# 例：AI_ALLOWED_USERS=你的用户名  或  AI_ALLOWED_USERS=用户名1,用户名2,123
AI_ALLOWED_USERS=

# AI 外部调用超时(ms)
AI_REQUEST_TIMEOUT_MS=60000

# 多轮对话携带的上下文消息条数（条数越多 token 成本越高，留意模型上下文窗口上限）
AI_CONTEXT_MESSAGES=40
