# ============ 基础 ============
# 复制为 .env 后修改
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# 生产环境对外访问地址（生成图片完整 URL 用）
# PUBLIC_BASE_URL=https://api.example.com

# ============ JWT ============
JWT_SECRET=your-random-secret-here
JWT_EXPIRES_IN=7d

# ============ MySQL ============
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=123456
DB_NAME=pindou
DB_POOL_SIZE=10

# ============ 缓存（memory / redis） ============
# 驱动：redis 或 memory。未配置 Redis 时默认 memory（零依赖可运行）
CACHE_DRIVER=memory
CACHE_TTL_SECONDS=60
CACHE_MAX_ITEMS=500
CACHE_PREFIX=pindou:

# 生产建议用 Redis（跨进程/跨实例共享）。docker-compose 已内置 Redis 服务，设 CACHE_DRIVER=redis 即可。
# 两种受支持的写法（二选一）：
#   REDIS_URL=redis://:password@127.0.0.1:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ============ 上传限制 ============
MAX_UPLOAD_SIZE_MB=10

# ============ CORS ============
# 生产建议指定前端域名，如 https://www.example.com
CORS_ORIGIN=*

# ============ 火山方舟 AI 配置 ============
VOLCANO_ARC_API_KEY=your-api-key-here
VOLCANO_ARC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 聊天模型（普通对话）
VOLCANO_CHAT_MODEL=your-chat-model-id

# 图片生成模型（文生图 / 图生图）
VOLCANO_IMAGE_MODEL=your-image-model-id

# 视觉模型（图片分析）
VOLCANO_VISION_MODEL=your-vision-model-id

# AI 外部调用超时(ms)
AI_REQUEST_TIMEOUT_MS=60000

# 多轮对话携带的上下文消息条数（条数越多 token 成本越高，留意模型上下文窗口上限）
AI_CONTEXT_MESSAGES=40
